{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otfabric/modbus-interop/fixtures/schema/modbus-fixture.schema.json",
  "title": "modbus-interop fixture",
  "description": "A Modbus device served by every reference server. See docs/FIXTURES.md.",
  "type": "object",
  "required": ["schemaVersion", "name", "unitId"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "description": { "type": "string" },
    "unitId": { "type": "integer", "minimum": 1, "maximum": 247 },
    "coils": { "$ref": "#/$defs/bitBlock" },
    "discreteInputs": { "$ref": "#/$defs/bitBlock" },
    "holdingRegisters": { "$ref": "#/$defs/registerBlock" },
    "inputRegisters": { "$ref": "#/$defs/registerBlock" },
    "deviceIdentification": {
      "type": "object",
      "required": ["objects"],
      "additionalProperties": false,
      "properties": {
        "objects": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["id", "value"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "integer", "minimum": 0, "maximum": 255 },
              "value": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[\\x20-\\x7e]*$" }
            }
          }
        }
      }
    },
    "reportServerId": {
      "description": "FC17: a one-byte server ID and the run indicator; the response carries no additional data.",
      "type": "object",
      "required": ["serverId", "runIndicator"],
      "additionalProperties": false,
      "properties": {
        "serverId": { "type": "integer", "minimum": 0, "maximum": 255 },
        "runIndicator": { "type": "boolean" }
      }
    },
    "fileRecords": {
      "description": "FC20/FC21: files of registers; a record number is the index in records.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "records"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "records": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "type": "integer", "minimum": 0, "maximum": 65535 } }
        }
      }
    },
    "fifoQueues": {
      "description": "FC24: FIFO queues by FIFO pointer address, oldest value first.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["address", "values"],
        "additionalProperties": false,
        "properties": {
          "address": { "$ref": "#/$defs/address" },
          "values": { "type": "array", "maxItems": 31, "items": { "type": "integer", "minimum": 0, "maximum": 65535 } }
        }
      }
    }
  },
  "$defs": {
    "address": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "bitBlock": {
      "type": "object",
      "required": ["address", "values"],
      "additionalProperties": false,
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "values": { "type": "array", "minItems": 1, "maxItems": 65536, "items": { "type": "boolean" } }
      }
    },
    "registerBlock": {
      "type": "object",
      "required": ["address", "values"],
      "additionalProperties": false,
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "values": { "type": "array", "minItems": 1, "maxItems": 65536, "items": { "type": "integer", "minimum": 0, "maximum": 65535 } }
      }
    }
  }
}
